{
  "name": "create-kei-game",
  "version": "0.2.0",
  "description": "The Kei game-building harness. Today it prepares the project a game will be built in — blank, a published template, a local project, or a repository — and stops.",
  "license": "MIT",
  "author": "Sano",
  "homepage": "https://github.com/keicoin-org/create-kei-game",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keicoin-org/create-kei-game.git"
  },
  "bugs": {
    "url": "https://github.com/keicoin-org/create-kei-game/issues"
  },
  "keywords": [
    "kei",
    "create",
    "harness",
    "game",
    "gamedev",
    "game-development",
    "cli"
  ],
  "type": "module",
  "bin": {
    "create-kei-game": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./source": {
      "types": "./dist/source.d.ts",
      "bun": "./src/source.ts",
      "import": "./dist/source.js"
    },
    "./providers": {
      "types": "./dist/providers.d.ts",
      "bun": "./src/providers.ts",
      "import": "./dist/providers.js"
    },
    "./harness": {
      "types": "./dist/harness.d.ts",
      "bun": "./src/harness.ts",
      "import": "./dist/harness.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "bun": "./src/agent.ts",
      "import": "./dist/agent.js"
    }
  },
  "files": [
    "dist",
    "src",
    "docs"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build && tsc -p tsconfig.tests.json",
    "test": "bun test",
    "check": "bun run typecheck && bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  }
}
