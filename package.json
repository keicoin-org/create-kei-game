{
  "name": "create-kei-game",
  "version": "0.2.0",
  "description": "Scaffold a browser game with a real currency and real items. Writes files and exits.",
  "license": "MIT",
  "author": "Sano",
  "homepage": "https://keicoin.org#harness",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keicoin-org/kei-transaction.git",
    "directory": "packages/create-kei-game"
  },
  "bugs": {
    "url": "https://github.com/keicoin-org/kei-transaction/issues"
  },
  "keywords": [
    "kei",
    "create",
    "scaffold",
    "starter",
    "game",
    "gamedev",
    "babylonjs",
    "browser-game"
  ],
  "type": "module",
  "bin": {
    "create-kei-game": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "templates"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "bun test",
    "typecheck": "bun run typecheck:src && bun run typecheck:templates && bun run typecheck:test",
    "typecheck:src": "tsc -p tsconfig.json --noEmit",
    "typecheck:templates": "tsc -p tsconfig.templates.json",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@babylonjs/core": "^9.19.0",
    "@keicoin/core": "^0.5.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.2",
    "kei-transaction": "^0.8.0",
    "typescript": "^5.9.0"
  }
}
