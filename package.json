{
  "name": "create-kei-game",
  "version": "0.2.0",
  "description": "The Kei game-building harness. Today it scaffolds a browser game with a real currency and real items, and exits.",
  "license": "MIT",
  "author": "Sano",
  "homepage": "https://github.com/keicoin-org/create-kei-game",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keicoin-org/create-kei-game.git"
  },
  "bugs": {
    "url": "https://github.com/keicoin-org/create-kei-game/issues"
  },
  "keywords": [
    "kei",
    "create",
    "harness",
    "scaffold",
    "starter",
    "game",
    "gamedev",
    "babylonjs",
    "browser-game"
  ],
  "type": "module",
  "bin": {
    "create-kei-game": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "templates"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "typecheck": "tsc --build && tsc -p tsconfig.tests.json",
    "test": "bun test",
    "check": "bun run typecheck && bun test"
  },
  "devDependencies": {
    "@keicoin/core": "^0.3.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.10.0",
    "kei-transaction": "^0.3.0",
    "typescript": "^5.9.0"
  }
}
